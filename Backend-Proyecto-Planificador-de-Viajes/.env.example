# Modelo LLM a usar
MODEL=gpt-5.1

# Clave de OpenAI
OPENAI_API_KEY=sk-...

# Clave de Tavily (motor de búsqueda de los agentes). Gratis en https://tavily.com
TAVILY_API_KEY=tvly-...

# Token de la Plataforma de CrewAI (Settings -> Integrations en app.crewai.com)
# Necesario para la integración con Google Calendar.
CREWAI_PLATFORM_INTEGRATION_TOKEN=PK_...

# Postgres donde el agente conversacional guarda el historial (checkpointer de
# LangGraph + tabla conversation_log). Sin esto, /chat devuelve 503 y solo
# funciona /plan-trip.
# La contrasena se URL-encodea sola, asi que pegala tal cual, con simbolos y todo.
# Supabase: usa el puerto 5432 (session mode), no el 6543.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# Opcional: si la pones, gana sobre las cinco de arriba (util al desplegar).
# DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
